//Declaring gobal variables

var sinusoidalSelect;
var triangleSelect;

//Events on sinusoidal page

onEvent("?sinButton", "click", function( ) {
  setText("?sinLabel", textList[0].text);
});

onEvent("sinusoidalDropdown", "change", function( ) {
  sinusoidalSelect = getText("sinusoidalDropdown");
  if (sinusoidalSelect == "Sin") {
    setProperty("sinusoidalImage", "image", (imageList[0]).image);
  } else if (sinusoidalSelect == "Cos") {
    setProperty("sinusoidalImage", "image", (imageList[1]).image);
  } else {
    setProperty("sinusoidalImage", "image", "");
  }
});

//Events on triangle page

onEvent("triangleDropdown", "change", function( ) {
  triangleSelect = getText("triangleDropdown");
  if (triangleSelect == "equilateral") {
    setProperty("triangleImage", "image", (imageList[2]).image);
    setText("triangleLabel", (textList[1]).text);
  } else if ((triangleSelect == "scalene")) {
    setProperty("triangleImage", "image", (imageList[3]).image);
    setText("triangleLabel", (textList[2]).text);
  } else if (triangleSelect == "isosceles") {
    setProperty("triangleImage", "image", (imageList[4]).image);
    setText("triangleLabel", (textList[3]).text);
  } else if ((triangleSelect == "right triangle")) {
    setProperty("triangleImage", "image", (imageList[5]).image);
    setText("triangleLabel", (textList[4]).text);
  } else if ((triangleSelect == "30-60-90 triangle")) {
    setProperty("triangleImage", "image", (imageList[6]).image);
    setText("triangleLabel", (textList[5]).text);
  } else if ((triangleSelect == "45-45-90 triangle")) {
    setProperty("triangleImage", "image", (imageList[7]).image);
    setText("triangleLabel", (textList[6]).text);
  } else {
    setProperty("triangleImage", "image", "");
    setText("triangleLabel", "Please select another option");
  }
});

//Determines which quadrant the degree is in on common degrees page (which is named unit page)

onEvent("degreeInput", "change", function( ) {
  var degree = getText("degreeInput");
  for (var i = 0; i < randomDegrees.length; i++) {
    if (degree <= 90) {
      setText("degreeLabel", degree + " degrees is in the first quadrant");
    } else if (degree <= 180) {
      setText("degreeLabel", degree + " degrees is in the second quadrant");
    } else if (degree <= 270) {
      setText("degreeLabel", degree + " degrees is in the third quadrant");
    } else if (degree <= 360) {
      setText("degreeLabel", degree + " degrees is in the fourth quadrant");
    } else {
      setText("degreeLabel", "Please type in a number from 0 to 360");
    }
  }
});

